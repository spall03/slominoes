{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true
    },
    "testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_ADMOB_USE_TEST_ADS": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "steve@2ndstrike.co",
        "ascAppId": "6785719918",
        "appleTeamId": "PQWCGM5H9E"
      }
    }
  }
}
