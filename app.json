{
  "expo": {
    "name": "Slominoes",
    "slug": "slominoes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "slominoes",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060614"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.2ndstrike.slominoes",
      "buildNumber": "4",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "We use this to show you ads relevant to your interests. You can opt out and the game still works fully — rewarded ads stay available either way.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.secondstrike.slominoes",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060614"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "./plugins/with-firebase-swift-app-delegate",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "react-native-iap",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBCrashlytics"
            ]
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3785726745879105~6236726544",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingUsageDescription": "We use this to show you ads relevant to your interests. You can opt out and the game still works fully.",
          "delayAppMeasurementInit": true,
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2ce262e8-5365-4833-909a-62b0f03954c7"
      }
    },
    "owner": "stevepalley"
  }
}
